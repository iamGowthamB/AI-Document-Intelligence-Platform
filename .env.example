# AI Engine Configuration (Flask Python)
HOST=0.0.0.0
PORT=5000
SECRET_KEY=your_flask_secret_key_here

# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_optional
HUGGINGFACE_HUB_TOKEN=your_huggingface_token_optional

# File & Vector Database Paths
UPLOADS_FOLDER=uploads
VECTORDB_DIR=vectordb/chroma_db

# Model Names
TEXT_LLM_MODEL=llama-3.3-70b-versatile
IMAGE_LLM_MODEL=gemini-2.5-flash
CIRCUIT_LLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Maximum Request File Size Limit (bytes, default 16MB)
MAX_CONTENT_LENGTH=16777216
